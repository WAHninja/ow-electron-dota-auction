{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "Dota 2 GSI Overlay",
    "author": "Your Name",
    "version": "1.0.0",
    "minimum-overwolf-electron-version": "1.0.0",
    "description": "Dota 2 overlay with GSI tracking",
    "icon": "icon.png"
  },
  "permissions": [
    "GameInfo",
    "Extensions",
    "Streaming",
    "Profile"
  ],
  "data": {
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [570]
    },
    "game_events": [],
    "start_window": "main",
    "windows": {
      "main": {
        "file": "src/renderer/index.html",
        "transparent": false,
        "resizable": true,
        "show": true,
        "width": 800,
        "height": 600
      },
      "overlay": {
        "file": "src/renderer/overlay.html",
        "transparent": true,
        "resizable": false,
        "show": false,
        "in_game_only": true,
        "width": 1920,
        "height": 1080,
        "clickthrough": false
      }
    }
  }
}